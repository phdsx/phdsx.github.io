{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@/*": ["./*"],
      "react": ["deployment/node_modules/@types/react"],
      "react/*": ["deployment/node_modules/@types/react/*"],
      "react-dom/*": ["deployment/node_modules/@types/react-dom/*"],
      "*": ["deployment/node_modules/*"]
    },
    "types": ["node", "react", "react-dom"],
    "typeRoots": ["./node_modules/@types"]
  },
  "files": ["client.tsx", "api.test.ts", "radar-search.test.ts", "published-data.ts", "../../../../worker/site.ts"]
}
